{
  "name": "analista-de-logs-com-llm",
  "version": "0.1.0",
  "description": "Vigia a rede de casa: descobre aparelhos, guarda o histórico e avisa quando algo muda.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "scan": "node --disable-warning=ExperimentalWarning src/index.js",
    "logs": "node --disable-warning=ExperimentalWarning src/logs.js",
    "triagem": "node --disable-warning=ExperimentalWarning src/triar.js",
    "responder": "node --disable-warning=ExperimentalWarning src/notas.js",
    "notas": "node --disable-warning=ExperimentalWarning src/notas.js --listar",
    "chave": "node --disable-warning=ExperimentalWarning src/config.js --guardar-chave",
    "vigiar": "node --disable-warning=ExperimentalWarning src/vigiar.js",
    "ferramentas": "node scripts/ferramentas.js",
    "app": "node scripts/app.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "zod": "^4.6.7"
  }
}
